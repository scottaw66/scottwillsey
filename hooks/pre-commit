#!/bin/bash
# Pre-commit hook for the single content tree (content/ + data/ are the
# source; there is no src/ YAML tree since 2026-10-25). Three jobs:
#   1. Bump the `date` of a watched page when it is committed: the four
#      singles content/pages/{links,now,uses,reviews}.md, data/spotlight.json
#      (bumps links.md), and data/reviews/<cat>.json (bumps that category's
#      "date" in data/reviews_meta.json — the review categories have no page
#      file of their own).
#   2. Rewrite the Recent Updates partial with the pages bumped in this commit.
#   3. Run tools/prebuild.py and stage its output, so derived fields
#      (display_modified, reviews_meta display dates, list stubs…) land in
#      the SAME commit as the edit that changed them.
# Installed by hooks/install.sh (copies this file to .git/hooks/pre-commit).

# Array to track updated pages
declare -a updated_pages=()

# Store the matched files in a temporary file to avoid subshell issues
tmpfile=$(mktemp)
git diff --cached --name-status |
grep -iE '^M.*(content/pages/(links|now|uses|reviews)\.md|data/reviews/(books|movies|music|tvshows)\.json|data/spotlight\.json)$' > "$tmpfile"

# Same hard-coded -08:00 as the Astro-era hook (never tracked DST).
now=$(TZ='America/Los_Angeles' date "+%Y-%m-%dT%H:%M:%S-08:00")

# Update timestamps for links, now, reviews, and uses pages.
while read _ file; do
    target="$file"      # the file whose date gets bumped
    meta_key=""         # set when the target is data/reviews_meta.json
    page_title=""
    page_url=""

    if [[ "$file" == "data/spotlight.json" ]]; then
        # Special case for spotlight.json: it is part of the Links page
        target="content/pages/links.md"
        page_title="Cool Site Spotlight"
        page_url="/links#CoolSiteSpotlight"
    elif [[ "$file" =~ data/reviews/([^/]+)\.json ]]; then
        # Review JSON: bump that category's date in reviews_meta.json
        base_name="${BASH_REMATCH[1]}"
        target="data/reviews_meta.json"

        # reviews_meta.json keys / URL segments per category
        case "$base_name" in
            "books")
                meta_key="books"
                page_title="Book Reviews"
                page_url="/reviews/books/1"
                ;;
            "movies")
                meta_key="movies"
                page_title="Movie Reviews"
                page_url="/reviews/movies/1"
                ;;
            "music")
                meta_key="music"
                page_title="Music Reviews"
                page_url="/reviews/music/1"
                ;;
            "tvshows")
                meta_key="tv"
                page_title="TV Reviews"
                page_url="/reviews/tv/1"
                ;;
        esac
    elif [[ "$file" == "content/pages/now.md" ]]; then
        page_title="/now"
        page_url="/now"
    elif [[ "$file" == "content/pages/uses.md" ]]; then
        page_title="/uses"
        page_url="/uses"
    elif [[ "$file" == "content/pages/reviews.md" ]]; then
        page_title="Reviews"
        page_url="/reviews"
    elif [[ "$file" == "content/pages/links.md" ]]; then
        page_title="Links"
        page_url="/links"
    fi

    if [[ -n "$meta_key" ]]; then
        # JSON: set the category's "date"; prebuild (below) recomputes its
        # display_modified from it.
        python3 - "$target" "$meta_key" "$now" <<'EOF'
import json, sys
path, key, now = sys.argv[1:]
meta = json.load(open(path))
meta[key]["date"] = now
with open(path, "w") as f:
    json.dump(meta, f, indent=2, ensure_ascii=False)
    f.write("\n")
EOF
    else
        # TOML frontmatter: replace the `date = …` line inside the leading
        # +++ block (bare TOML datetime, no quotes). The 1,/^+++$/ range runs
        # from line 1 to the NEXT +++ line, so a `date = ` in the body is
        # never touched.
        bumped=$(mktemp)
        sed "1,/^+++\$/s/^date = .*\$/date = $now/" "$target" > "$bumped"
        mv "$bumped" "$target"
    fi
    git add "$target"

    # Add to updated pages array
    if [[ -n "$page_title" && -n "$page_url" ]]; then
        updated_pages+=("$page_title|$page_url")
    fi
done < "$tmpfile"

rm -f "$tmpfile"

# Update the Recent Updates partial with updated pages (only if there are new updates)
if [[ ${#updated_pages[@]} -gt 0 ]]; then
    updates_file="templates/partials/recent_updates.html"
    if [[ -f "$updates_file" ]]; then
        # Get last 5 unique pages from new updates only
        recent_updates=$(printf '%s\n' "${updated_pages[@]}" | awk '!seen[$0]++' | tail -5)

        # Build the HTML list
        updates_html=""
        while IFS='|' read -r title url; do
            [[ -n "$title" ]] && updates_html+="    <li><a href=\"${url}\">${title}</a></li>\n"
        done <<< "$recent_updates"

        # Replace the updates section content with new updates
        awk -v updates="$updates_html" '
        /<section id="updates"/ {
            # Found the opening section tag
            print "<section id=\"updates\" class=\"text-[0.8em]\">"
            if (updates != "") {
                print "  <ul>"
                printf "%s", updates
                print "  </ul>"
            }
            print "</section>"
            # Skip until we find the closing </section> tag
            while (getline > 0 && !/<\/section>/) { }
            next
        }
        { print }
        ' "$updates_file" > tmp && mv tmp "$updates_file"

        git add "$updates_file"
    fi
fi

# Refresh the generated artifacts from the just-bumped files and stage them,
# so derived output lands in the SAME commit. Without this, a commit that
# bumped a date left display_modified / reviews_meta / list stubs stale — the
# next build regenerated them and dirtied the repo, forcing a second commit
# (observed 2026-08-08 with the old converter). Runs whenever anything under
# content/ or data/ is staged: it's <1s and idempotent.
# Note: prebuild reads the WORKING TREE, so partially-staged content/data
# changes would leak their derived output (and `git add content data` stages
# the rest of those dirs) into this commit — commit content changes together
# rather than split.
if git diff --cached --name-only | grep -qE '^(content|data)/'; then
    if python3 tools/prebuild.py >/dev/null 2>&1; then
        git add content data
    else
        echo "pre-commit: tools/prebuild.py failed — run it to see the errors, fix, and retry"
        exit 1
    fi
fi
